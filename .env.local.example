# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (Resend)
RESEND_API_KEY=re_...

# Admin auth
ADMIN_SECRET=change-me-strong-secret
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_ADMIN_NEEDS_SECRET=true

# MercadoPago
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=your-mp-webhook-signing-secret

# Cron jobs (use same secret in Vercel Cron auth header)
CRON_SECRET=change-me-strong-secret

# Base URL (use the same value for all three in each environment)
NEXT_PUBLIC_BASE_URL=https://candidato.com.co
NEXT_PUBLIC_SITE_URL=https://candidato.com.co
NEXT_PUBLIC_APP_URL=https://candidato.com.co
